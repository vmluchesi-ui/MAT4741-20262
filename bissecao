def bisseccao(f, a, b, tol=1e-6, max_iter=100):
    if f(a) * f(b) > 0:
        raise ValueError("Intervalo inválido")

    for i in range(max_iter):
        m = (a + b) / 2
        if abs(f(m)) < tol:
            return m
        if f(a) * f(m) < 0:
            b = m
        else:
            a = m

    return (a + b) / 2
